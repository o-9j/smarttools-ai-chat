/** Cloudflare Worker configuration for SmartTools AI Chat. */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smarttools-ai-chat",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smarttools-users",
      "database_id": "adf44698-eaaf-44b7-bec3-e64aff8bf10a"
    }
  ],
  "upload_source_maps": true
}
